# Source-only milestone: dependencies, assets and machine state stay local.
/*
!/.gitignore
!/README.md
!/README-demo.md
!/MILESTONE.md
!/CHECKPOINT.md
!/run-*.sh
!/vr/
!/benchmark/
/vr/*
!/vr/*.c
!/vr/*.cpp
!/vr/*.h
!/vr/*.hpp
!/vr/*.hlsl
!/vr/*.py
!/vr/*.sh
!/vr/*.md
!/vr/tests/
/vr/tests/*
!/vr/tests/*.c
!/vr/tests/*.cpp
!/vr/tests/*.py
!/vr/shaders/
/vr/shaders/*
!/vr/shaders/*.comp
!/vr/capture/
/vr/capture/*
!/vr/capture/*.c
!/vr/capture/*.sh
/benchmark/*
!/benchmark/*.py
!/benchmark/RESULTS.md
# Never commit executable runtimes, archives, models or credentials.
*.dll
*.exe
*.pdb
*.zip
*.glb
*.blend
*.bin
*.npy
*.png
*.ppm
__pycache__/
.env*
